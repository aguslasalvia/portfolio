---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TechBadge from '../../components/TechBadge.astro';
import GithubIcon from '../../components/icons/GithubIcon.astro';
import ExternalLinkIcon from '../../components/icons/ExternalLinkIcon.astro';
import { portfolio } from '../../data/portfolio';

export function getStaticPaths() {
  return portfolio.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const images = project.images?.length ? project.images : project.image ? [project.image] : [];
---

<Layout title={`${project.title} | Agustin Lasalvia`}>
  <Header />
  <main class="project-page">
    <div class="container">
      <a href="/#projects" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to projects
      </a>

      <div class="project-header">
        <div class="title-row">
          <div class="title-block">
            <div class="route-bar">
              <span class="method method-get">GET</span>
              <span class="route-path">/projects/{project.slug}</span>
            </div>
            <h1>{project.title}</h1>
          </div>
          {'latest' in project && project.latest && <span class="latest-badge">Latest</span>}
        </div>
        <div class="project-links">
          {project.github && (
            <a href={project.github} target="_blank" rel="noopener" class="btn btn-outline">
              <GithubIcon width={15} height={15} />
              GitHub
            </a>
          )}
          {project.demo && (
            <a href={project.demo} target="_blank" rel="noopener" class="btn btn-primary">
              <ExternalLinkIcon width={15} height={15} />
              Live Demo
            </a>
          )}
        </div>
      </div>

      <div class="tech-list">
        {project.tech.map((t) => (
          <TechBadge name={t} />
        ))}
      </div>

      <p class="project-description" set:html={project.longDescription ?? project.description} />

      {images.length > 0 && (
        <div class={`gallery${images.length === 1 ? ' single' : ''}`}>
          {images.map((img) => (
            <div class="gallery-item">
              <img src={img} alt={`${project.title} screenshot`} loading="lazy" />
            </div>
          ))}
        </div>
      )}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .project-page {
    padding-top: 8rem;
    padding-bottom: 2rem;
    min-height: 100vh;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--accent-light);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .title-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .title-block .route-bar {
    margin-bottom: 0.4rem;
  }

  .project-header h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .project-links {
    display: flex;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .project-links .btn svg {
    flex-shrink: 0;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.75rem;
  }

  .project-description {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 2.5rem;
  }

  .project-description :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .project-description :global(a:hover) {
    color: var(--accent-hover);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    padding-bottom: 4rem;
  }

  .gallery.single {
    grid-template-columns: 1fr;
  }

  .gallery-item {
    border: none;
    border-radius: 20px;
    overflow: hidden;
    background: var(--bg-primary);
    box-shadow:
      inset 5px 5px 11px var(--neu-dark),
      inset -4px -4px 10px var(--neu-light);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .project-page {
      padding-top: 6.5rem;
    }

    .project-header h1 {
      font-size: 1.5rem;
    }

    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
