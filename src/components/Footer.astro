---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p>&copy; {year} Agustin. Built with Astro.</p>
  </div>
</footer>

<style>
  .footer {
    padding: 2rem 0;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .footer p {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }
</style>
