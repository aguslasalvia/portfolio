---
import { getTechIcon } from '../utils/techIcons';

interface Props {
  name: string;
}

const { name } = Astro.props;
const icon = getTechIcon(name);
---

<span class="tech-badge">
  {icon && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="12"
      height="12"
      aria-hidden="true"
      style="fill: currentColor; flex-shrink: 0; opacity: 0.7;"
    >
      <path d={icon.path} />
    </svg>
  )}
  {name}
</span>

