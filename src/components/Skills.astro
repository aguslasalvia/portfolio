---
import { portfolio } from '../data/portfolio';
import TechBadge from './TechBadge.astro';

const categories = [
  { label: 'Backend', key: 'backend' as const },
  { label: 'Frontend', key: 'frontend' as const },
  { label: 'Databases & Tools', key: 'tools' as const },
];
---

<section id="skills" class="skills">
  <div class="container">
    <span class="section-eyebrow fade-in">What I work with</span>
    <h2 class="section-title fade-in fade-in-delay-1">Skills</h2>

    <div class="categories">
      {categories.map((cat, i) => (
        <div class={`category fade-in fade-in-delay-${i + 1}`}>
          <div class="category-accent"></div>
          <h3 class="category-label">{cat.label}</h3>
          <div class="skill-list">
            {portfolio.skills[cat.key].map(skill => (
              <TechBadge name={skill.name} />
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    background: var(--bg-secondary);
  }

  .categories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .category {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
  }

  .category:hover {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 6px 30px var(--accent-glow);
    transform: translateY(-3px);
  }

  .category-accent {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--accent);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    opacity: 0.7;
  }

  .category-label {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-light);
    margin-bottom: 1.25rem;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .categories { grid-template-columns: 1fr; }
  }
</style>
