---
import { portfolio } from '../data/portfolio';
import TechBadge from './TechBadge.astro';

const categories = [
  { key: 'backend' as const },
  { key: 'frontend' as const },
  { key: 'tools' as const },
];
---

<section id="skills" class="skills">
  <div class="container">
    <div class="route-bar fade-in">
      <span class="method method-get">GET</span>
      <span class="route-path">/skills</span>
    </div>
    <h2 class="section-title fade-in fade-in-delay-1">Skills</h2>

    <div class="json-panel fade-in fade-in-delay-2">
      <div class="json-panel-bar">
        <span class="json-status">200 <span class="status-text">OK</span></span>
        <span class="json-panel-label">application/json</span>
      </div>
      <div class="json-panel-body">
        <span class="brace">{'{'}</span>
        {categories.map((cat, i) => (
          <div class="skills-line">
            <span class="json-key">"{cat.key}"</span><span class="json-colon">:</span>
            <span class="json-bracket">[</span>
            <span class="skills-badges">
              {portfolio.skills[cat.key].map(skill => (
                <TechBadge name={skill.name} />
              ))}
            </span>
            <span class="json-bracket">]</span>{i < categories.length - 1 && <span class="json-comma">,</span>}
          </div>
        ))}
        <span class="brace">{'}'}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    background: var(--bg-secondary);
  }

  .json-panel {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .json-panel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-secondary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .json-status {
    color: var(--accent-light);
    font-weight: 600;
  }

  .json-status .status-text {
    color: var(--text-muted);
    font-weight: 500;
    margin-left: 0.3em;
  }

  .json-panel-label {
    color: var(--text-muted);
  }

  .json-panel-body {
    padding: 1.4rem 1.5rem 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 2.1;
  }

  .brace {
    display: block;
    color: var(--text-muted);
  }

  .skills-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.4rem;
    padding-left: 1.1rem;
  }

  .json-key {
    color: var(--accent-light);
  }

  .json-colon {
    color: var(--text-muted);
  }

  .json-bracket,
  .json-comma {
    color: var(--text-muted);
  }

  .skills-badges {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.5rem 0;
  }

  @media (max-width: 640px) {
    .json-panel-body {
      font-size: 0.78rem;
    }
  }
</style>
