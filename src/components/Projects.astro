---
import { portfolio } from '../data/portfolio';
import TechBadge from './TechBadge.astro';
---

<section id="projects" class="projects">
  <div class="container">
    <span class="section-eyebrow fade-in">Things I've built</span>
    <h2 class="section-title fade-in fade-in-delay-1">Projects</h2>
    <div class="projects-grid">
      {portfolio.projects.map((project, i) => (
        <article class={`project-card fade-in fade-in-delay-${(i % 4) + 1}${'latest' in project && project.latest ? ' latest' : ''}`}>
          {project.image && (
            <a href={`/projects/${project.slug}`} class="card-image">
              <img src={project.image} alt={`${project.title} screenshot`} loading="lazy" />
              <span class="card-image-overlay">View project</span>
            </a>
          )}
          <div class="card-body">
            <div class="card-top">
              <div class="title-row">
                <h3 class="project-title">
                  <a href={`/projects/${project.slug}`}>{project.title}</a>
                </h3>
                {'latest' in project && project.latest && <span class="latest-badge">Latest</span>}
              </div>
              <div class="project-links">
                {project.github && (
                  <a href={project.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                  </a>
                )}
                {project.demo && (
                  <a href={project.demo} target="_blank" rel="noopener" aria-label="Live demo" title="Live Demo">
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                )}
              </div>
            </div>
            <p class="project-description" set:html={project.description} />
            <div class="tech-list">
              {project.tech.map(t => (
                <TechBadge name={t} />
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .project-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
  }

  .project-card.latest {
    border-color: var(--accent);
    box-shadow: 0 0 24px var(--accent-glow);
  }

  .project-card:hover {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 8px 40px var(--accent-glow);
    transform: translateY(-4px);
  }

  .card-image {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.5s ease;
    display: block;
  }

  .project-card:hover .card-image img {
    transform: scale(1.06);
  }

  .card-image-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
    background: rgba(12, 10, 9, 0.55);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .project-card:hover .card-image-overlay {
    opacity: 1;
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .title-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .project-title a {
    color: var(--text-primary);
    transition: color 0.2s;
  }

  .project-title a:hover {
    color: var(--accent-light);
  }

  .latest-badge {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-light);
    background: var(--accent-glow);
    border: 1px solid var(--accent);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    line-height: 1.4;
  }

  .project-links {
    display: flex;
    gap: 0.45rem;
    flex-shrink: 0;
  }

  .project-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .project-links a:hover {
    border-color: var(--accent);
    color: var(--accent-light);
    background: var(--accent-glow);
  }

  .project-description {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.65;
    flex: 1;
  }

  .project-description :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .project-description :global(a:hover) {
    color: var(--accent-hover);
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
