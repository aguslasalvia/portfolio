---
import { portfolio } from '../data/portfolio';

---

<section id="about" class="about">
  <div class="container">
    <div class="route-bar fade-in">
      <span class="method method-get">GET</span>
      <span class="route-path">/about</span>
    </div>
    <h2 class="section-title fade-in fade-in-delay-1">About me</h2>
    <div class="content">
      {portfolio.about.map((paragraph, i) => (
        <p class={`fade-in fade-in-delay-${i + 1}`}>{paragraph}</p>
      ))}
    </div>

  </div>
</section>

<style>
  .about {
    background: var(--bg-secondary);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 720px;
  }

  .content p {
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 0.975rem;
    padding-left: 1.1rem;
    border-left: 2px solid var(--border);
    transition: border-color 0.2s;
  }

  .content p:hover {
    border-left-color: var(--accent);
  }

</style>
