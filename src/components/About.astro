---
import { portfolio } from '../data/portfolio';

---

<section id="about" class="about">
  <div class="container">
    <span class="section-eyebrow fade-in">Who I am</span>
    <h2 class="section-title fade-in fade-in-delay-1">About me</h2>
    <div class="content">
      {portfolio.about.map((paragraph, i) => (
        <p class={`fade-in fade-in-delay-${i + 1}`}>{paragraph}</p>
      ))}
    </div>

  </div>
</section>

<style>
  .about {
    background: var(--bg-secondary);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .content p {
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 0.975rem;
  }

</style>
