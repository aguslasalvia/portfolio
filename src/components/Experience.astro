---
import { portfolio } from '../data/portfolio';
import ExperienceTimeline from './react/ExperienceTimeline';

const experiences = portfolio.experience.map(exp => ({
  ...exp,
  isCurrent: exp.period.toLowerCase().includes('present'),
}));
---

<section id="experience" class="experience">
  <div class="container">
    <div class="route-bar fade-in">
      <span class="method method-get">GET</span>
      <span class="route-path">/experience</span>
    </div>
    <h2 class="section-title fade-in fade-in-delay-1">Experience</h2>
    <ExperienceTimeline client:visible experiences={experiences} />
  </div>
</section>

<style>
  .experience {
    background: var(--bg-secondary);
  }
</style>
