---
import { portfolio } from "../data/portfolio";
import { getTechIcon } from "../utils/techIcons";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";

const heroTechs = ["Node.js", "MongoDB", "Python", "C#", "Go", "MySQL"];
const [firstName, ...rest] = portfolio.name.split(" ");
const lastName = rest.join(" ");
---

<section class="hero">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-glow hero-glow--top" aria-hidden="true"></div>
  <div class="hero-glow hero-glow--bottom" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <div class="route-bar">
          <span class="method method-get">GET</span>
          <span class="route-path">/whoami</span>
        </div>

        <h1 class="hero-name">
          <span class="hero-name-line">{firstName}</span>
          <span class="hero-name-line hero-name-accent">{lastName}</span>
        </h1>

        <p class="hero-title">{portfolio.title}</p>
        <p class="hero-location">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
            ></path><circle cx="12" cy="10" r="3"></circle></svg
          >
          {portfolio.location}<span class="hero-location-sep">·</span>open to new opportunities
        </p>
        <p class="hero-description">{portfolio.description}</p>

        <div class="cta">
          <a href={portfolio.cvLink} class="btn btn-primary" download>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
              ></path><polyline points="7 10 12 15 17 10"></polyline><line
                x1="12"
                y1="15"
                x2="12"
                y2="3"></line></svg
            >
            Download CV
          </a>
          <a href="#projects" class="btn btn-outline">View Projects</a>
        </div>

        <div class="socials">
          <a
            href={portfolio.socials.github}
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
          >
            <GithubIcon />
          </a>
          <a
            href={portfolio.socials.linkedin}
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn"
          >
            <LinkedInIcon />
          </a>
          <a
            href={portfolio.socials.instagram}
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"
              ></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
              ></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg
            >
          </a>
        </div>
      </div>

      <div class="hero-image-wrap">
        <div class="hero-image-ring">
          <img src="/profile.png" alt={portfolio.name} class="hero-image" />
        </div>
        {
          heroTechs.map((name, i) => {
            const icon = getTechIcon(name);
            return (
              <span class={`float-badge fb-${i + 1}`} aria-hidden="true">
                {icon && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d={icon.path} />
                  </svg>
                )}
              </span>
            );
          })
        }
      </div>
    </div>
  </div>

  <div class="scroll-indicator" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg
    >
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 6rem;
    overflow: hidden;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--dot-color) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
    mask-image: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      black 40%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      black 40%,
      transparent 100%
    );
  }

  .hero-glow {
    position: absolute;
    pointer-events: none;
  }

  .hero-glow--top {
    top: -10%;
    right: -5%;
    width: 700px;
    height: 700px;
    background: radial-gradient(
      circle,
      rgba(249, 115, 22, 0.13) 0%,
      transparent 65%
    );
  }

  .hero-glow--bottom {
    bottom: -15%;
    left: -8%;
    width: 550px;
    height: 550px;
    background: radial-gradient(
      circle,
      rgba(239, 68, 68, 0.08) 0%,
      transparent 65%
    );
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
  }

  .hero-image-wrap {
    order: 2;
    position: relative;
    animation: fadeUp 0.7s 0.1s ease both;
  }

  .hero-text {
    order: 1;
    max-width: 640px;
  }

  .route-bar {
    margin-bottom: 1.5rem;
    animation: fadeUp 0.6s 0.02s ease both;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 8vw, 5.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 0.98;
    margin-bottom: 1.1rem;
    animation: fadeUp 0.6s 0.05s ease both;
  }

  .hero-name-line {
    display: block;
    color: var(--text-primary);
  }

  .hero-name-accent {
    color: var(--accent);
    background: linear-gradient(100deg, var(--accent) 0%, var(--accent-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-title {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 0.6rem;
    animation: fadeUp 0.6s 0.1s ease both;
  }

  .hero-location {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
    animation: fadeUp 0.6s 0.15s ease both;
  }

  .hero-location-sep {
    margin: 0 0.15em;
    opacity: 0.6;
  }

  .hero-description {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 2.25rem;
    max-width: 520px;
    animation: fadeUp 0.6s 0.2s ease both;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    animation: fadeUp 0.6s 0.25s ease both;
  }

  .socials {
    display: flex;
    gap: 0.75rem;
    animation: fadeUp 0.6s 0.3s ease both;
  }

  .socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: none;
    background: var(--bg-primary);
    color: var(--text-muted);
    box-shadow:
      4px 4px 9px var(--neu-dark),
      -3px -3px 8px var(--neu-light);
    transition: color 0.2s, box-shadow 0.2s;
  }

  .socials a:hover {
    color: var(--accent-light);
    box-shadow:
      inset 3px 3px 7px var(--neu-dark),
      inset -2px -2px 6px var(--neu-light);
  }

  .float-badge {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg-primary);
    border: none;
    color: var(--accent-light);
    box-shadow:
      5px 5px 11px var(--neu-dark),
      -4px -4px 10px var(--neu-light);
    animation: floaty 5s ease-in-out infinite;
  }

  .float-badge svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
    opacity: 1;
  }

  .fb-1 { top: 14%; right: 2px; animation-delay: 0s; }
  .fb-2 { top: 45%; right: -26px; animation-delay: 0.6s; }
  .fb-3 { top: 14%; left: 2px; animation-delay: 1.2s; }
  .fb-4 { top: 73%; right: 2px; animation-delay: 1.8s; }
  .fb-5 { top: 73%; left: 2px; animation-delay: 2.4s; }
  .fb-6 { top: 45%; left: -26px; animation-delay: 3s; }

  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-9px); }
  }

  .hero-image-ring {
    position: relative;
    display: flex;
    justify-content: center;
    filter: drop-shadow(0 0 3px var(--accent))
      drop-shadow(0 0 10px var(--accent))
      drop-shadow(0 0 26px rgba(249, 115, 22, 0.45));
    animation: heroFloat 6s ease-in-out infinite;
  }

  .hero-image {
    width: 360px;
    height: auto;
    display: block;
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 95%,
      transparent 100%
    );
    mask-image: linear-gradient(to bottom, #000 95%, transparent 100%);
  }

  @keyframes heroFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--text-muted);
    animation: bounce 2.5s ease-in-out infinite;
    opacity: 0.5;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(9px); }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-image-wrap {
      order: unset;
      display: flex;
      justify-content: center;
    }
    .hero-text {
      order: unset;
      max-width: 100%;
    }
    .hero-image {
      width: 250px;
    }
    .route-bar,
    .hero-location,
    .cta,
    .socials {
      justify-content: center;
    }
    .hero-description {
      max-width: 100%;
    }
    .scroll-indicator {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .cta {
      flex-direction: column;
    }
    .btn {
      justify-content: center;
    }
  }
</style>
