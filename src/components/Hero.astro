---
import { portfolio } from "../data/portfolio";
---

<section class="hero">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-glow hero-glow--top" aria-hidden="true"></div>
  <div class="hero-glow hero-glow--bottom" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-content">
      <div class="hero-image-wrap">
        <div class="hero-image-ring">
          <img src="/profile.png" alt={portfolio.name} class="hero-image" />
        </div>
      </div>

      <div class="hero-text">
        <p class="hero-eyebrow">Hello, I'm</p>
        <h1 class="hero-name">{portfolio.name}</h1>
        <p class="hero-title">{portfolio.title}</p>
        <p class="hero-location">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
            ></path><circle cx="12" cy="10" r="3"></circle></svg
          >
          {portfolio.location}
        </p>
        <p class="hero-description">{portfolio.description}</p>

        <div class="cta">
          <a href={portfolio.cvLink} class="btn btn-primary" download>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
              ></path><polyline points="7 10 12 15 17 10"></polyline><line
                x1="12"
                y1="15"
                x2="12"
                y2="3"></line></svg
            >
            Download CV
          </a>
          <a href="#projects" class="btn btn-outline">View Projects</a>
        </div>

        <div class="socials">
          <a
            href={portfolio.socials.github}
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
              ></path></svg
            >
          </a>
          <a
            href={portfolio.socials.linkedin}
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
              ></path><rect x="2" y="9" width="4" height="12"></rect><circle
                cx="4"
                cy="4"
                r="2"></circle></svg
            >
          </a>
          <a
            href={portfolio.socials.instagram}
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"
              ></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
              ></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg
            >
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="scroll-indicator" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg
    >
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 6rem;
    overflow: hidden;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--dot-color) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
    mask-image: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      black 40%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      black 40%,
      transparent 100%
    );
  }

  .hero-glow {
    position: absolute;
    pointer-events: none;
  }

  .hero-glow--top {
    top: -10%;
    right: -5%;
    width: 700px;
    height: 700px;
    background: radial-gradient(
      circle,
      rgba(249, 115, 22, 0.13) 0%,
      transparent 65%
    );
  }

  .hero-glow--bottom {
    bottom: -15%;
    left: -8%;
    width: 550px;
    height: 550px;
    background: radial-gradient(
      circle,
      rgba(239, 68, 68, 0.08) 0%,
      transparent 65%
    );
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }

  .hero-image-wrap {
    order: 2;
  }
  .hero-text {
    order: 1;
    max-width: 520px;
  }

  .hero-eyebrow {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
    animation: fadeUp 0.6s ease both;
  }

  .hero-name {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent-light) 0%, #ef4444 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.4rem;
    animation: fadeUp 0.6s 0.05s ease both;
  }

  .hero-title {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 0.6rem;
    animation: fadeUp 0.6s 0.1s ease both;
  }

  .hero-location {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
    animation: fadeUp 0.6s 0.15s ease both;
  }

  .hero-description {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 2rem;
    animation: fadeUp 0.6s 0.2s ease both;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    animation: fadeUp 0.6s 0.25s ease both;
  }

  .socials {
    display: flex;
    gap: 0.75rem;
    animation: fadeUp 0.6s 0.3s ease both;
  }

  .socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition:
      border-color 0.2s,
      color 0.2s,
      background 0.2s,
      box-shadow 0.2s;
  }

  .socials a:hover {
    border-color: var(--accent);
    color: var(--accent-light);
    background: var(--accent-glow);
    box-shadow: 0 0 16px var(--accent-glow);
  }

  .hero-image-wrap {
    animation: fadeUp 0.7s 0.1s ease both;
  }

  .hero-image-ring {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, var(--accent) 0%, #ef4444 100%);
    box-shadow: 0 0 50px rgba(249, 115, 22, 0.2);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--text-muted);
    animation: bounce 2.5s ease-in-out infinite;
    opacity: 0.5;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(9px);
    }
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-image-wrap {
      order: unset;
      display: flex;
      justify-content: center;
    }
    .hero-text {
      order: unset;
      max-width: 100%;
    }
    .hero-image-ring {
      width: 180px;
      height: 180px;
    }
    .hero-location,
    .cta,
    .socials {
      justify-content: center;
    }
    .scroll-indicator {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .cta {
      flex-direction: column;
    }
    .btn {
      justify-content: center;
    }
  }
</style>
