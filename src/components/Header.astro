---
const navLinks = [
  { path: '/about', href: '/#about' },
  { path: '/skills', href: '/#skills' },
  { path: '/experience', href: '/#experience' },
  { path: '/projects', href: '/#projects' },
  { path: '/contact', href: '/#contact' },
];
---

<header class="header" id="header">
  <nav class="nav">
    <a href="/" class="logo">AL</a>

    <div class="nav-links" id="navLinks">
      {navLinks.map(link => (
        <a href={link.href} class="nav-link" data-section={link.href.split('#')[1]}>{link.path}</a>
      ))}
    </div>

    <div class="nav-actions">
      <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      </button>

      <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    {navLinks.map(link => (
      <a href={link.href} class="mobile-link" data-section={link.href.split('#')[1]}>{link.path}</a>
    ))}
  </div>
</header>

<script>
  const toggle = document.getElementById('menuToggle') as HTMLButtonElement;
  const menu = document.getElementById('mobileMenu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open');
    toggle.classList.toggle('active');
    toggle.setAttribute('aria-expanded', String(isOpen));
    menu?.setAttribute('aria-hidden', String(!isOpen));
  });

  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.remove('open');
      toggle?.classList.remove('active');
      toggle?.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('aria-hidden', 'true');
    });
  });

  const header = document.getElementById('header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  // Active link
  const sections = document.querySelectorAll('section[id]');
  const allLinks = document.querySelectorAll('.nav-link[data-section], .mobile-link[data-section]');

  const setActive = (id: string) => {
    allLinks.forEach(link => {
      link.classList.toggle('active', link.getAttribute('data-section') === id);
    });
  };

  const sectionObserver = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) setActive(e.target.id); }),
    { rootMargin: '-40% 0px -55% 0px' }
  );
  sections.forEach(s => sectionObserver.observe(s));

  // Theme toggle
  const themeBtn = document.getElementById('themeToggle') as HTMLButtonElement;

  const applyTheme = (light: boolean) => {
    document.documentElement.classList.toggle('light', light);
    themeBtn?.classList.toggle('is-light', light);
  };

  applyTheme(document.documentElement.classList.contains('light'));

  themeBtn?.addEventListener('click', () => {
    const isLight = !document.documentElement.classList.contains('light');
    applyTheme(isLight);
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    background: rgba(12, 10, 9, 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: border-color 0.3s, background-color 0.3s;
  }

  :global(.light) .header {
    background: rgba(250, 250, 249, 0.78);
  }

  .header.scrolled {
    border-bottom-color: var(--border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.85rem 2rem;
  }

  @media (max-width: 768px) {
    .nav {
      padding: 0.75rem 1.25rem;
    }
  }

  .logo {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.3rem 0.65rem;
    border-radius: 8px;
    border: none;
    background: var(--bg-primary);
    color: var(--accent-light);
    box-shadow:
      3px 3px 7px var(--neu-dark),
      -2px -2px 6px var(--neu-light);
    transition: box-shadow 0.2s ease;
    flex-shrink: 0;
  }

  .logo:hover {
    box-shadow:
      inset 2px 2px 5px var(--neu-dark),
      inset -1px -1px 4px var(--neu-light);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    font-family: var(--font-mono);
  }

  .nav-link {
    position: relative;
    font-size: 0.8rem;
    color: var(--text-muted);
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.active {
    color: var(--accent-light);
    background: var(--bg-primary);
    box-shadow:
      inset 2px 2px 5px var(--neu-dark),
      inset -1px -1px 4px var(--neu-light);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-left: 0.5rem;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: none;
    background: var(--bg-primary);
    color: var(--text-muted);
    box-shadow:
      3px 3px 7px var(--neu-dark),
      -2px -2px 6px var(--neu-light);
    cursor: pointer;
    transition: color 0.2s, box-shadow 0.2s;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    color: var(--accent-light);
    box-shadow:
      inset 2px 2px 5px var(--neu-dark),
      inset -1px -1px 4px var(--neu-light);
  }

  .theme-toggle .icon-sun  { display: none; }
  .theme-toggle .icon-moon { display: block; }
  .theme-toggle.is-light .icon-sun  { display: block; }
  .theme-toggle.is-light .icon-moon { display: none; }

  /* Hamburger */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
  }

  .menu-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text-secondary);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center;
  }

  .menu-toggle.active span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .menu-toggle.active span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .menu-toggle.active span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* Mobile dropdown */
  .mobile-menu {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    max-height: 0;
    font-family: var(--font-mono);
    background: var(--bg-primary);
    border-top: 0 solid var(--border);
    transition: max-height 0.35s ease, padding 0.3s ease, border-width 0.3s ease;
  }

  .mobile-menu.open {
    max-height: 320px;
    padding: 0.5rem 1.25rem 1rem;
    border-top-width: 1px;
  }

  .mobile-link {
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding: 0.7rem 0.5rem;
    border-bottom: 1px solid var(--border);
    transition: color 0.2s;
  }

  .mobile-link:last-child { border-bottom: none; }

  .mobile-link:hover  { color: var(--text-primary); }
  .mobile-link.active { color: var(--accent-light); }

  @media (min-width: 769px) {
    .menu-toggle  { display: none; }
    .mobile-menu  { display: none !important; }
  }

  @media (max-width: 768px) {
    .nav-links   { display: none; }
    .menu-toggle { display: flex; }
  }
</style>
